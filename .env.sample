DB_HOST=localhost
DB_USER=your_user_name
DB_PASSWORD=your_password
DB_NAME=your_DB_name
DB_PORT=3306
PORT=4242

# Front-end URL pour CORS
CORS_ORIGIN=http://localhost:5173

# URL publique de l'API (pour construire les URLs d'images et la CSP)
API_URL=http://localhost:4242
IMAGE_BASE_URL=http://localhost:4242

# "production" ou "development"
NODE_ENV=development

# À lancer DEUX FOIS (un secret par ligne)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Secret aléatoire ≥ 32 bytes (256 bits), encodé en base64
ACCESS_TOKEN_SECRET=une_longue_chaîne_aléatoire_secrète_1
REFRESH_TOKEN_SECRET=une_autre_longue_chaîne_aléatoire_secrète_2

# === LOGS ===
LOG_LEVEL=info
LOG_DIR=./logs

# === LOGS CLIENT (optionnel) ===
CLIENT_LOG_ENABLED=false

# === EMAIL (optionnel - pour notifications contact/guestbook) ===
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=noreply@herve-petit.com
NOTIFY_EMAIL=admin@herve-petit.com
