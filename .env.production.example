# === BASE DE DONNÉES ===
DB_HOST=localhost
DB_USER=site_herve_prod
DB_PASSWORD=CHANGEME_strong_password
DB_NAME=site_herve_prod
DB_PORT=3306

# === SERVEUR ===
PORT=4242
# Écoute locale uniquement — Nginx reverse-proxy (ne pas mettre 0.0.0.0)
HOST=127.0.0.1
NODE_ENV=production

# === SÉCURITÉ JWT ===
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCESS_TOKEN_SECRET=CHANGEME_generate_unique_secret
REFRESH_TOKEN_SECRET=CHANGEME_generate_unique_secret

# === CORS ET URLS ===
CORS_ORIGIN=https://www.herve-petit.com
API_URL=https://www.herve-petit.com
IMAGE_BASE_URL=https://www.herve-petit.com

# === LOGS ===
LOG_LEVEL=warn
LOG_DIR=/var/log/site-herve
CLIENT_LOG_ENABLED=true

# === EMAIL (optionnel) ===
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@herve-petit.com
SMTP_PASS=CHANGEME_smtp_password
SMTP_FROM=Site Hervé Petit <noreply@herve-petit.com>
NOTIFY_EMAIL=herve@herve-petit.com
